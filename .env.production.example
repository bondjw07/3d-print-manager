# Public app port on the host (Unraid/Nginx Proxy Manager can target this)
APP_PORT=3000

# Docker image to run (built and published by GitHub Actions).
APP_IMAGE=ghcr.io/REPLACE_WITH_YOUR_GITHUB_OWNER/REPLACE_WITH_YOUR_REPO:main

# Runtime settings
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Postgres container credentials
POSTGRES_USER=printportal
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=printportal

# Prisma datasource URL (uses the compose service name "postgres")
DATABASE_URL=postgresql://printportal:replace-with-a-long-random-password@postgres:5432/printportal?schema=public
