{
  "name": "print-management-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "predev": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/production.mjs",
    "start:web": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "worker:file-processing": "tsx src/server/jobs/file-processing-worker.ts",
    "images:repair-missing": "tsx scripts/repair-missing-product-images.ts",
    "bambuddy:cleanup-legacy-filament": "tsx scripts/bambuddy-cleanup-legacy-filament.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.8.0",
    "next": "^16.3.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^3.5.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
